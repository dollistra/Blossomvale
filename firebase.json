{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs22",
    "ignore": ["node_modules", ".git", "firebase-debug.log", "firebase-debug.*.log"]
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "firestore.rules",
      "ADMIN_SETUP.md",
      "dev-server.js",
      "server.js",
      "server-stats.json",
      "package.json",
      "package-lock.json",
      "functions/**",
      "**/node_modules/**",
      "**/.*"
    ],
    "cleanUrls": true,
    "trailingSlash": false
  }
}
